{
  "Oidc": {
    "Authority": "https://localhost:5001",
    "Audience": "pulseguard.telemetry",
    "RequireHttpsMetadata": true
  },
  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http2"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
