{
  "Oidc": {
    "Authority": "https://localhost:5001",
    "Audience": "pulseguard.patient-registry",
    "RequireHttpsMetadata": true
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Messaging": {
    "RabbitMq": {
      "HostName": "localhost",
      "Port": 5672,
      "VirtualHost": "/",
      "UserName": "pulseguard",
      "ExchangeName": "pulseguard.events",
      "ClientProvidedName": "pulseguard-patient-registry",
      "RequestedHeartbeat": "00:00:30",
      "ConnectionTimeout": "00:00:10",
      "PublishTimeout": "00:00:10",
      "Routes": {
        "PatientRegisteredIntegrationEvent": "pulseguard.patient-registry.patient-registered.v1"
      }
    }
  },
  "OpenTelemetry": {
    "Enabled": false,
    "OtlpEndpoint": "http://localhost:4317",
    "ServiceNamespace": "PulseGuard"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
