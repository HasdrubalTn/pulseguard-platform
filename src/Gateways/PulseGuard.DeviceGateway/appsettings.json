{
  "Hl7": {
    "Mllp": {
      "BindAddress": "127.0.0.1",
      "Port": 2575,
      "MaximumMessageBytes": 1048576,
      "ReadTimeoutSeconds": 30,
      "MaximumConcurrentConnections": 100
    }
  },
  "Messaging": {
    "RabbitMq": {
      "HostName": "localhost",
      "Port": 5672,
      "VirtualHost": "/",
      "UserName": "pulseguard",
      "ExchangeName": "pulseguard.events",
      "ClientProvidedName": "pulseguard-device-gateway",
      "RequestedHeartbeat": "00:00:30",
      "ConnectionTimeout": "00:00:10",
      "PublishTimeout": "00:00:10",
      "Routes": {
        "Hl7MessageReceivedIntegrationEvent": "pulseguard.interoperability.hl7-message-received.v1"
      }
    }
  },
  "OpenTelemetry": {
    "Enabled": false,
    "OtlpEndpoint": "http://localhost:4317",
    "ServiceNamespace": "PulseGuard"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
